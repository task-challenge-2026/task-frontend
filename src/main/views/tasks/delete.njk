{% extends "template.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block pageTitle %}Delete task - Caseworker tasks - GOV.UK{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: "/tasks/" + task.id }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Are you sure you want to delete "{{ task.title }}"?</h1>

      {{ govukWarningText({ text: "You cannot undo this. The task's status history will be kept for audit." }) }}

      <form method="post" action="/tasks/{{ task.id }}/delete" novalidate>
        <div class="govuk-button-group">
          {{ govukButton({ text: "Yes, delete task", classes: "govuk-button--warning" }) }}
          <a class="govuk-link" href="/tasks/{{ task.id }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
