{% extends "template.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "macros/task-tag.njk" import taskTags %}

{% block pageTitle %}Your tasks - Caseworker tasks - GOV.UK{% endblock %}

{% block content %}
  {% if banner %}
    {{ govukNotificationBanner({ type: "success", text: banner }) }}
  {% endif %}

  <h1 class="govuk-heading-xl">Your tasks</h1>

  {{ govukButton({ text: "Create a task", href: "/tasks/new" }) }}

  <form method="get" action="/" novalidate>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-one-quarter">
        {{ govukSelect({ id: "sort", name: "sort", label: { text: "Sort by" }, items: sortOptions }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {{ govukSelect({ id: "order", name: "order", label: { text: "Order" }, items: orderOptions }) }}
      </div>
      <div class="govuk-grid-column-one-quarter">
        {{ govukSelect({ id: "status", name: "status", label: { text: "Status" }, items: statusFilterOptions }) }}
      </div>
    </div>
    {{ govukButton({ text: "Apply", classes: "govuk-button--secondary" }) }}
  </form>

  {% if tasks.length %}
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-visually-hidden">Your tasks</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Task</th>
          <th scope="col" class="govuk-table__header">Status</th>
          <th scope="col" class="govuk-table__header">Due</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for task in tasks %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="/tasks/{{ task.id }}">{{ task.title }}</a>
            </td>
            <td class="govuk-table__cell">{{ taskTags(task) }}</td>
            <td class="govuk-table__cell">{{ task.dueAtText }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="govuk-body">There are no tasks to show.</p>
  {% endif %}
{% endblock %}
